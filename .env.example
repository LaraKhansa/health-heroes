# Copy this file to .env and fill in the values

# Google Gemini API key (powers the chatbot, meal recommender and activity generator)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# Optional settings
# GEMINI_MODEL=gemini-2.5-flash
# DATABASE_URL=sqlite:////absolute/path/to/health_heroes.db
# APP_ENV=production    # requires SECRET_KEY, enables secure cookies, turns off debug
# PORT=5000
